<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Course · Épingle</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    width: 100%; height: 100%; overflow: hidden;
    background: #87ceeb; touch-action: none;
    -webkit-user-select: none; user-select: none;
    font-family: 'Courier New', monospace;
  }
  canvas { display: block; position: fixed; inset: 0; }

  #hud {
    position: fixed; top: max(14px, env(safe-area-inset-top)); left: 0; right: 0;
    display: flex; justify-content: space-between;
    padding: 0 20px; pointer-events: none;
    color: #fff; text-shadow: 2px 2px 0 rgba(0,0,0,.6);
    z-index: 10;
  }
  #timer { font-size: 30px; font-weight: bold; letter-spacing: 2px; }
  #top3 { font-size: 13px; text-align: right; line-height: 1.5; }

  /* Zones tactiles */
  #zones { position: fixed; inset: 0; z-index: 5; pointer-events: none; }
  .zone { position: absolute; pointer-events: auto; }
  .zone-top    { top: 0; left: 25%; right: 25%; height: 28%; }
  .zone-bottom { bottom: 0; left: 25%; right: 25%; height: 28%; }
  .zone-left   { top: 0; bottom: 0; left: 0; width: 30%; }
  .zone-right  { top: 0; bottom: 0; right: 0; width: 30%; }

  /* Indication visuelle au 1er lancement */
  #hint {
    position: fixed; inset: 0; z-index: 20;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none; color: #fff;
    font-size: 18px; text-align: center;
    text-shadow: 2px 2px 4px rgba(0,0,0,.8);
    transition: opacity .6s;
  }
  #hint.hide { opacity: 0; }
  #hint .box {
    background: rgba(0,0,0,.5);
    padding: 18px 26px; border-radius: 14px; line-height: 1.7;
  }
</style>
</head>
<body>

<div id="hud">
  <div id="timer">00:00.000</div>
  <div id="top3"></div>
</div>

<div id="zones">
  <div class="zone zone-top"    data-act="accel"></div>
  <div class="zone zone-left"   data-act="left"></div>
  <div class="zone zone-right"  data-act="right"></div>
  <div class="zone zone-bottom" data-act="brake"></div>
</div>

<div id="hint">
  <div class="box">
    ⬆️ Touche en haut pour accélérer<br>
    ⬇️ Touche en bas pour freiner<br>
    ⬅️➡️ Côtés pour tourner<br>
    ⏬ Double-tap bas = rétrograder
  </div>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
    "cannon-es": "https://unpkg.com/cannon-es@0.20.0/dist/cannon-es.js"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
import * as CANNON from 'cannon-es';

/* ============================================================
   SCÈNE 3D
   ============================================================ */
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87ceeb);
scene.fog = new THREE.Fog(0x87ceeb, 55, 140);

const camera = new THREE.PerspectiveCamera(55, innerWidth / innerHeight, 0.1, 500);
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.body.appendChild(renderer.domElement);

// Lumières
const sun = new THREE.DirectionalLight(0xffffff, 1.15);
sun.position.set(30, 60, 20);
sun.castShadow = true;
sun.shadow.mapSize.set(1024, 1024);
sun.shadow.camera.left = -60; sun.shadow.camera.right = 60;
sun.shadow.camera.top = 60; sun.shadow.camera.bottom = -60;
sun.shadow.camera.near = 1; sun.shadow.camera.far = 200;
scene.add(sun);
scene.add(new THREE.AmbientLight(0xffffff, 0.6));

/* ============================================================
   PHYSIQUE
   ============================================================ */
const world = new CANNON.World({ gravity: new CANNON.Vec3(0, -20, 0) });
world.defaultContactMaterial.friction = 0.25;
world.defaultContactMaterial.restitution = 0.05;

/* ============================================================
   DÉCOR : MER
   ============================================================ */
const sea = new THREE.Mesh(
  new THREE.PlaneGeometry(600, 600),
  new THREE.MeshLambertMaterial({ color: 0x1e90ff })
);
sea.rotation.x = -Math.PI / 2;
sea.position.y = -1.2;
sea.receiveShadow = true;
scene.add(sea);

/* ============================================================
   CIRCUIT — pente droite + épingle serrée
   Segments définis par {x, z, angle, length}
   La route se dessine en cubes plats.
   ============================================================ */
const ROAD_W = 7;
const ROAD_THICK = 0.3;

// Tracé : ligne droite du nord au sud, puis épingle serrée vers la gauche
const SEGMENTS = [
  // Pente droite (descente)
  { x:  0, z:  8, angle: 0,               length: 24 },
  { x:  0, z: -8, angle: 0,               length: 8  },

  // Approche du virage
  { x: -1.5, z: 22, angle: -Math.PI / 10, length: 6 },
  { x: -5,   z: 26, angle: -Math.PI / 4,  length: 7 },
  { x: -9.5, z: 28, angle: -Math.PI / 2,  length: 7 },
  { x: -14,  z: 26, angle: -3 * Math.PI / 4, length: 7 },
  { x: -18,  z: 22, angle: Math.PI,       length: 6 },

  // Ligne droite de sortie (arrivée)
  { x: -18,  z: 12, angle: Math.PI,       length: 14 },
];

const roadMat = new THREE.MeshLambertMaterial({ color: 0x555555 });
const lineMat = new THREE.MeshBasicMaterial({ color: 0xffdd33 });

SEGMENTS.forEach((seg, i) => {
  // Route
  const road = new THREE.Mesh(
    new THREE.BoxGeometry(seg.length, ROAD_THICK, ROAD_W),
    roadMat
  );
  road.position.set(seg.x, 0, seg.z);
  road.rotation.y = seg.angle;
  road.receiveShadow = true;
  scene.add(road);

  // Ligne jaune centrale
  const line = new THREE.Mesh(
    new THREE.BoxGeometry(seg.length * 0.9, ROAD_THICK + 0.02, 0.3),
    lineMat
  );
  line.position.set(seg.x, 0.005, seg.z);
  line.rotation.y = seg.angle;
  scene.add(line);

  // Murs physiques (invisibles) sur les deux côtés
  for (const side of [-1, 1]) {
    const offLocal = new CANNON.Vec3(0, 0, side * (ROAD_W / 2 + 0.3));
    const q = new CANNON.Quaternion();
    q.setFromEuler(0, seg.angle, 0);
    const offWorld = q.vmult(offLocal);

    const wallBody = new CANNON.Body({
      mass: 0,
      shape: new CANNON.Box(new CANNON.Vec3(seg.length / 2, 0.8, 0.3)),
    });
    wallBody.position.set(seg.x + offWorld.x, 0.8, seg.z + offWorld.z);
    wallBody.quaternion.copy(q);
    world.addBody(wallBody);
  }
});

// Plots décoratifs (petits cubes colorés aux bords, alternance)
const plotColors = [0xff6b6b, 0x4ecdc4, 0xffe66d, 0xa29bfe];
SEGMENTS.forEach((seg, i) => {
  const step = 4;
  const count = Math.floor(seg.length / step);
  for (let k = 0; k <= count; k++) {
    const t = (k / count - 0.5) * seg.length;
    for (const side of [-1, 1]) {
      const px = seg.x + Math.cos(seg.angle) * t + Math.sin(seg.angle) * side * (ROAD_W / 2 + 0.9);
      const pz = seg.z - Math.sin(seg.angle) * t + Math.cos(seg.angle) * side * (ROAD_W / 2 + 0.9);

      const plot = new THREE.Mesh(
        new THREE.BoxGeometry(0.7, 1.0, 0.7),
        new THREE.MeshLambertMaterial({ color: plotColors[(i + k) % plotColors.length] })
      );
      plot.position.set(px, 0.5, pz);
      plot.rotation.y = seg.angle;
      plot.castShadow = true;
      scene.add(plot);
    }
  }
});

// Sol physique global (empêche de tomber dans le vide)
const groundBody = new CANNON.Body({
  mass: 0,
  shape: new CANNON.Plane(),
});
groundBody.quaternion.setFromEuler(-Math.PI / 2, 0, 0);
world.addBody(groundBody);

/* ============================================================
   LA VOITURE — cube rouge + toit jaune, lourde et inerte
   ============================================================ */
const carBody = new CANNON.Body({
  mass: 7,                                       // très lourd
  shape: new CANNON.Box(new CANNON.Vec3(1.0, 0.35, 1.7)),
  position: new CANNON.Vec3(0, 0.5, -18),
  linearDamping: 0.12,
  angularDamping: 0.55,                          // empêche les rotations vives
});
world.addBody(carBody);

const carGroup = new THREE.Group();

const carBodyMesh = new THREE.Mesh(
  new THREE.BoxGeometry(2.0, 0.7, 3.4),
  new THREE.MeshLambertMaterial({ color: 0xff3355 })
);
carBodyMesh.castShadow = true;
carBodyMesh.receiveShadow = true;
carGroup.add(carBodyMesh);

const carRoofMesh = new THREE.Mesh(
  new THREE.BoxGeometry(1.5, 0.55, 1.5),
  new THREE.MeshLambertMaterial({ color: 0xffe66d })
);
carRoofMesh.position.set(0, 0.62, -0.15);
carRoofMesh.castShadow = true;
carGroup.add(carRoofMesh);

// Petits phares (pour l'orientation visuelle)
const headlightMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
for (const side of [-1, 1]) {
  const h = new THREE.Mesh(new THREE.BoxGeometry(0.35, 0.25, 0.15), headlightMat);
  h.position.set(side * 0.6, 0.05, 1.7);
  carGroup.add(h);
}

scene.add(carGroup);

/* ============================================================
   CONTRÔLES TACTILES + CLAVIER (pour test desktop)
   ============================================================ */
const input = { accel: false, brake: false, left: false, right: false };
let speedLevel = 0;                  // 0 à 4
let lastBottomTap = 0;
const MAX_LEVEL = 4;

function onZonePress(act) {
  if (act === 'accel') {
    speedLevel = Math.min(MAX_LEVEL, speedLevel + 1);
    input.accel = true;
  } else if (act === 'brake') {
    input.brake = true;
    const now = performance.now();
    if (now - lastBottomTap < 280) {
      speedLevel = Math.max(0, speedLevel - 1);
    }
    lastBottomTap = now;
  } else if (act === 'left')  input.left = true;
  else if (act === 'right') input.right = true;
}

function onZoneRelease(act) {
  if (act === 'accel') input.accel = false;
  else if (act === 'brake') input.brake = false;
  else if (act === 'left')  input.left = false;
  else if (act === 'right') input.right = false;
}

document.querySelectorAll('.zone').forEach((z) => {
  const act = z.dataset.act;
  z.addEventListener('touchstart', (e) => { e.preventDefault(); onZonePress(act); }, { passive: false });
  z.addEventListener('touchend',   (e) => { e.preventDefault(); onZoneRelease(act); }, { passive: false });
  z.addEventListener('touchcancel',(e) => { e.preventDefault(); onZoneRelease(act); }, { passive: false });
  // Souris (desktop)
  z.addEventListener('mousedown', () => onZonePress(act));
  z.addEventListener('mouseup',   () => onZoneRelease(act));
  z.addEventListener('mouseleave',() => onZoneRelease(act));
});

// Clavier desktop
window.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowUp')    { speedLevel = Math.min(MAX_LEVEL, speedLevel + 1); input.accel = true; }
  if (e.key === 'ArrowDown')  input.brake = true;
  if (e.key === 'ArrowLeft')  input.left = true;
  if (e.key === 'ArrowRight') input.right = true;
});
window.addEventListener('keyup', (e) => {
  if (e.key === 'ArrowUp')    input.accel = false;
  if (e.key === 'ArrowDown')  input.brake = false;
  if (e.key === 'ArrowLeft')  input.left = false;
  if (e.key === 'ArrowRight') input.right = false;
});

/* ============================================================
   TRACES DE DÉRAPAGE (persistantes en mémoire locale)
   ============================================================ */
const SKID_Y = 0.17;
const skidMat = new THREE.MeshBasicMaterial({
  color: 0x111111, transparent: true, opacity: 0.55, depthWrite: false,
});
const skidGeo = new THREE.PlaneGeometry(0.35, 0.6);
const skidMeshes = [];
const MAX_SKIDS = 2000;

function addSkid(x, z, rot) {
  const m = new THREE.Mesh(skidGeo, skidMat);
  m.rotation.x = -Math.PI / 2;
  m.rotation.z = rot;
  m.position.set(x, SKID_Y, z);
  scene.add(m);
  skidMeshes.push(m);
  if (skidMeshes.length > MAX_SKIDS) {
    const old = skidMeshes.shift();
    scene.remove(old);
  }
}

/* ============================================================
   CHRONO + RECORDS LOCAUX
   ============================================================ */
const timerEl = document.getElementById('timer');
const top3El  = document.getElementById('top3');

let started = false;
let startTime = 0;
let finished = false;

function formatTime(ms) {
  const s = Math.floor(ms / 1000);
  const m = Math.floor(s / 60);
  const rest = Math.floor(ms % 1000);
  return `${String(m).padStart(2,'0')}:${String(s%60).padStart(2,'0')}.${String(rest).padStart(3,'0')}`;
}

// Records sauvegardés en localStorage (sur ton iPhone)
function loadTop3() {
  try { return JSON.parse(localStorage.getItem('course_top3') || '[]'); }
  catch { return []; }
}
function saveTop3(rows) {
  localStorage.setItem('course_top3', JSON.stringify(rows));
}
function refreshTop3() {
  const rows = loadTop3();
  top3El.innerHTML = rows.map((r, i) =>
    `${['🥇','🥈','🥉'][i]} ${formatTime(r)}`
  ).join('<br>');
}
function registerTime(ms) {
  const rows = loadTop3();
  rows.push(Math.round(ms));
  rows.sort((a, b) => a - b);
  saveTop3(rows.slice(0, 3));
  refreshTop3();
}
refreshTop3();

/* ============================================================
   LIGNE D'ARRIVÉE
   ============================================================ */
const FINISH = { x: -18, z: 5, radius: 3.5 };

// Marqueur visuel d'arrivée (damier simple)
const finishCheck = new THREE.Mesh(
  new THREE.BoxGeometry(ROAD_W, 0.32, 2),
  new THREE.MeshBasicMaterial({ color: 0xffffff })
);
finishCheck.position.set(FINISH.x, 0.01, FINISH.z);
finishCheck.rotation.y = Math.PI;
scene.add(finishCheck);

/* ============================================================
   BOUCLE PRINCIPALE
   ============================================================ */
const clock = new THREE.Clock();
let skidCooldown = 0;

function applyCarForces(dt) {
  const q = carBody.quaternion;
  const forward = new CANNON.Vec3(0, 0, 1);
  q.vmult(forward, forward);

  const speed = Math.hypot(carBody.velocity.x, carBody.velocity.z);

  // Poussée moteur (par niveau)
  if (speedLevel > 0) {
    const force = speedLevel * 65;
    carBody.applyForce(
      new CANNON.Vec3(forward.x * force, 0, forward.z * force),
      carBody.position
    );
  }

  // Frein
  if (input.brake) {
    carBody.applyForce(
      new CANNON.Vec3(-carBody.velocity.x * 10, 0, -carBody.velocity.z * 10),
      carBody.position
    );
  }

  // Direction : + efficace à basse vitesse (inertie)
  const steerStrength = 22 * (1 - Math.min(speed / 14, 0.72));
  if (input.left)  carBody.angularVelocity.y += steerStrength * dt * 4;
  if (input.right) carBody.angularVelocity.y -= steerStrength * dt * 4;

  // Vitesse max selon niveau
  const maxSpeed = speedLevel * 8;
  if (speed > maxSpeed) {
    carBody.velocity.x *= maxSpeed / speed;
    carBody.velocity.z *= maxSpeed / speed;
  }
}

function detectDrift() {
  const q = carBody.quaternion;
  const forward = new CANNON.Vec3(0, 0, 1);
  q.vmult(forward, forward);

  const v = carBody.velocity;
  const speed = Math.hypot(v.x, v.z);
  if (speed < 2) return null;

  // Produit scalaire normalisé = décalage entre direction et vitesse
  const dot = (v.x * forward.x + v.z * forward.z) / speed;
  const slip = Math.acos(Math.max(-1, Math.min(1, dot))); // en radians

  if (slip > 0.35) return { slip, speed };
  return null;
}

function animate() {
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);

  // Démarrage chrono au premier input
  if (!started && (input.accel || input.brake || input.left || input.right)) {
    started = true;
    startTime = performance.now();
    document.getElementById('hint').classList.add('hide');
  }

  if (started && !finished) {
    timerEl.textContent = formatTime(performance.now() - startTime);
  }

  applyCarForces(dt);
  world.step(1 / 60, dt, 3);

  // Sync visuel / physique
  carGroup.position.set(carBody.position.x, carBody.position.y, carBody.position.z);
  carGroup.quaternion.set(
    carBody.quaternion.x, carBody.quaternion.y,
    carBody.quaternion.z, carBody.quaternion.w
  );

  // Caméra suit
  const camOffset = new THREE.Vector3(13, 16, 13);
  const targetPos = new THREE.Vector3(carBody.position.x, 0, carBody.position.z);
  camera.position.lerp(targetPos.clone().add(camOffset), 0.09);
  camera.lookAt(targetPos);

  // Trace de dérapage
  skidCooldown -= dt;
  const drift = detectDrift();
  if (drift && skidCooldown <= 0) {
    skidCooldown = 0.05;
    for (const side of [-0.7, 0.7]) {
      const off = new CANNON.Vec3(side, 0, -1.0);
      const wOff = carBody.quaternion.vmult(off);
      addSkid(
        carBody.position.x + wOff.x,
        carBody.position.z + wOff.z,
        carBody.quaternion.y
      );
    }
  }

  // Détection arrivée
  if (!finished && started) {
    const d = Math.hypot(carBody.position.x - FINISH.x, carBody.position.z - FINISH.z);
    if (d < FINISH.radius) {
      finished = true;
      const ms = performance.now() - startTime;
      registerTime(ms);
      // On redémarre automatiquement après 2 sec
      setTimeout(() => {
        carBody.position.set(0, 0.5, -18);
        carBody.velocity.set(0, 0, 0);
        carBody.angularVelocity.set(0, 0, 0);
        carBody.quaternion.set(0, 0, 0, 1);
        speedLevel = 0;
        started = false;
        finished = false;
        timerEl.textContent = '00:00.000';
      }, 2000);
    }
  }

  renderer.render(scene, camera);
}

/* ============================================================
   RESIZE
   ============================================================ */
addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

animate();
</script>

</body>
</html>
